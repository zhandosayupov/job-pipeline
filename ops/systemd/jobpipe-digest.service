[Unit]
Description=jobpipe: daily digest to Telegram (oneshot)
After=network-online.target

[Service]
Type=oneshot
User=jobpipe
Group=jobpipe
Environment=JOBPIPE_HOME=/var/lib/jobpipe
Environment=JOBPIPE_SECRETS=/etc/jobpipe/secrets.env
WorkingDirectory=/opt/jobpipe
ExecStart=/opt/jobpipe/.venv/bin/jobpipe run digest
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jobpipe
PrivateTmp=true
