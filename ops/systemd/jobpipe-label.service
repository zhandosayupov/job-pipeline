[Unit]
Description=jobpipe: label prefiltered jobs with the LLM, shortlist, send cards (oneshot)
After=network-online.target

[Service]
Type=oneshot
User=jobpipe
Group=jobpipe
Environment=JOBPIPE_HOME=/var/lib/jobpipe
Environment=JOBPIPE_SECRETS=/etc/jobpipe/secrets.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/jobpipe
ExecStart=/opt/jobpipe/.venv/bin/jobpipe run label
TimeoutStartSec=1800
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jobpipe
PrivateTmp=true
