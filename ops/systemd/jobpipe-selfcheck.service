[Unit]
Description=jobpipe: selfcheck: alert on broken timers, queue, backups, workers (oneshot)
After=network-online.target

[Service]
Type=oneshot
User=jobpipe
Group=jobpipe
Environment=JOBPIPE_HOME=/var/lib/jobpipe
Environment=JOBPIPE_SECRETS=/etc/jobpipe/secrets.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/jobpipe
ExecStart=/opt/jobpipe/.venv/bin/jobpipe selfcheck
TimeoutStartSec=120
MemoryMax=150M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jobpipe
PrivateTmp=true
