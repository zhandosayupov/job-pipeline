[Unit]
Description=jobpipe: read Gmail, triage, move the funnel, draft replies (oneshot)
After=network-online.target

[Service]
Type=oneshot
User=jobpipe
Group=jobpipe
Environment=JOBPIPE_HOME=/var/lib/jobpipe
Environment=JOBPIPE_SECRETS=/etc/jobpipe/secrets.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/jobpipe
ExecStart=/opt/jobpipe/.venv/bin/jobpipe run inbox
TimeoutStartSec=600
MemoryMax=250M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jobpipe
PrivateTmp=true
