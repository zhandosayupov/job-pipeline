# jobpipe secrets. On the VM: /etc/jobpipe/secrets.env (mode 600, owner jobpipe).
# Locally: $JOBPIPE_HOME/secrets.env. Never commit the filled-in file.

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# S4: shared with the laptop worker (worker.env). Any long random string, e.g. `openssl rand -hex 32`.
WORKER_TOKEN=
# S5: a Google app password (Google Account -> Security -> 2-Step Verification -> App passwords).
# Full mailbox access: keep it only here. jobpipe reads mail and writes drafts; it never sends.
GMAIL_APP_PASSWORD=
